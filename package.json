{
  "name": "view-me-claude",
  "displayName": "View Me Claude",
  "description": "A light panel beside Claude Code: your phones (adb), running Claude agents and builds, plan usage, servers your agents started, and recent sessions to resume.",
  "version": "0.2.0",
  "publisher": "buggypather",
  "icon": "media/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/buggypather/view-me-claude#readme",
  "bugs": {
    "url": "https://github.com/buggypather/view-me-claude/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buggypather/view-me-claude"
  },
  "keywords": [
    "claude",
    "claude code",
    "adb",
    "android",
    "agents",
    "usage",
    "dashboard"
  ],
  "galleryBanner": {
    "color": "#0b2a4a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "viewMeClaude",
          "title": "View Me Claude",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "viewMeClaude": [
        {
          "type": "webview",
          "id": "viewMeClaude.panel",
          "name": "Phones, agents, builds"
        }
      ]
    },
    "commands": [
      {
        "command": "viewMeClaude.toggle",
        "title": "Toggle View Me Claude",
        "icon": "media/icon.svg"
      },
      {
        "command": "viewMeClaude.refresh",
        "title": "View Me Claude: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "viewMeClaude.setupUsage",
        "title": "View Me Claude: Turn on usage percentages"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "viewMeClaude.toggle",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "viewMeClaude.refresh",
          "when": "view == viewMeClaude.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "View Me Claude",
      "properties": {
        "viewMeClaude.intervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 3,
          "description": "How often to check while the panel is visible. Raise it on a slow computer."
        },
        "viewMeClaude.adbPath": {
          "type": "string",
          "default": "",
          "description": "Full path to adb if it isn't on PATH (e.g. C:\\Users\\you\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe)."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce package"
  }
}
